{
  "name": "dsh-thinking-levels",
  "version": "2.0.1",
  "description": "DSH host plugin: thinking-level (reasoning_effort) control for dsh — auto-adjust per tool round, with optional manual lock and per-tool timing telemetry.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-thinking-levels.git"
  },
  "type": "module",
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "README.ja.md",
    "README.ko.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "INSTALL.ja.md",
    "INSTALL.ko.md",
    "CHANGELOG.md",
    "CHANGELOG.ja.md",
    "CHANGELOG.ko.md"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./thinking-level": {
      "types": "./lib/thinking-level.d.ts",
      "default": "./lib/thinking-level.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-alpha.1 <0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "eslint": "^10.8.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "beta"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
